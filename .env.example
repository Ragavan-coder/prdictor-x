# ==============================================================================
# PREDICTRA-X Environment Configuration (.env.example)
# Copy this file to .env in production and local development
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. KEYCLOAK IDENTITY PROVIDER (Local Dev & Production)
# ------------------------------------------------------------------------------
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=predictra-x
KEYCLOAK_CLIENT_ID=predictra-x-frontend

# Production HTTPS URL examples:
# KEYCLOAK_URL=https://auth.predictra-x.com
# VITE_KEYCLOAK_URL=https://auth.predictra-x.com

# Keycloak Admin Credentials (Local Docker Development Only - NEVER commit real passwords)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=SentraAdmin#2026!

# ------------------------------------------------------------------------------
# 2. POSTGRESQL DATABASE (For Keycloak & Backend State)
# ------------------------------------------------------------------------------
POSTGRES_DB=keycloak
POSTGRES_USER=keycloak
POSTGRES_PASSWORD=KeycloakPgSecurePass2026!
POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# 3. FASTAPI BACKEND API CONFIGURATION
# ------------------------------------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# In production:
# BACKEND_CORS_ORIGINS=https://portal.predictra-x.com,https://app.predictra-x.com

# ------------------------------------------------------------------------------
# 4. FRONTEND VITE ENVIRONMENT (predictra-app/.env)
# ------------------------------------------------------------------------------
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=predictra-x
VITE_KEYCLOAK_CLIENT_ID=predictra-x-frontend
VITE_API_BASE_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# 5. ENTERPRISE POSTGRESQL PERSISTENCE
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://keycloak:KeycloakPgSecurePass2026!@localhost:5432/predictra_x

# ------------------------------------------------------------------------------
# 6. MINIO / ENTERPRISE S3 OBJECT STORAGE
# ------------------------------------------------------------------------------
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=MinioSecurePass2026!
MINIO_SECURE=false
MINIO_BUCKET=fdr-documents
# Fallback storage directory if MinIO container is not reachable
LOCAL_STORAGE_DIR=storage/documents

# ------------------------------------------------------------------------------
# 7. UNIVERSAL READING ENGINE & AI VISION (OPTIONAL / PRODUCTION)
# ------------------------------------------------------------------------------
# High-precision heuristic fallback is active by default.
# Point to remote vLLM / Ollama instance for Qwen2.5-VL:
QWEN_VL_ENDPOINT=
QWEN_VL_API_KEY=
